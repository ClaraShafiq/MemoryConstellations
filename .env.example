# ═══════════════════════════════════════════════════════
# Memory Constellations — 环境变量模板
# 复制为 .env 后填入实际值
# ═══════════════════════════════════════════════════════

# ── 必填 ──
# 数据库加密密钥（64位hex，用 `openssl rand -hex 32` 生成）
SANCTUARY_ENCRYPTION_KEY=

# Session 密钥（64位随机hex）
SESSION_SECRET=

# 登录密码（明文，启动时会自动 bcrypt 哈希）
LOGIN_PASSWORD=

# LLM API Key（至少配一个）
API_KEY=

# ── LLM 渠道（至少配一个）──
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# ── 可选 ──
# Jina Embedding API Key（默认使用本地 fastembed，不填则自动下载模型）
# JINA_API_KEY=

# 出站代理（国内访问 Google/OpenRouter API 用）
# HTTP_PROXY=http://127.0.0.1:7890

# 端口（默认 3000）
# PORT=3000
