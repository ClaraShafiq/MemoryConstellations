# ═══════════════════════════════════════════════════════
# Memory Constellations — 环境变量模板
# 复制为 .env 后填入实际值
# ═══════════════════════════════════════════════════════

# ── 必填 ──
# 数据库加密密钥（64位hex，用 `openssl rand -hex 32` 生成）
SANCTUARY_ENCRYPTION_KEY=

# Session 密钥（64位随机hex）
SESSION_SECRET=

# 登录密码（明文，启动时会自动 bcrypt 哈希）
LOGIN_PASSWORD=

# ── 记忆管线模型连接（四项必须同时填写）──
# provider 只表示请求协议，不绑定具体供应商或模型。
# 可选：gemini / openai_compatible
MEMORY_LLM_PROVIDER=
MEMORY_LLM_ENDPOINT=
MEMORY_LLM_MODEL=
MEMORY_LLM_API_KEY=
# MEMORY_LLM_NAME=memory-pipeline

# ── 可选 ──
# Jina Embedding API Key（默认使用本地 fastembed，不填则自动下载模型）
# JINA_API_KEY=

# 出站代理（只有部署环境确实需要时才设置；未设置则直连）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# 端口（默认 3000）
# PORT=3000

# IANA 时区；Docker 模板默认 UTC，本机启动未设置时使用系统时区
# TZ=UTC
